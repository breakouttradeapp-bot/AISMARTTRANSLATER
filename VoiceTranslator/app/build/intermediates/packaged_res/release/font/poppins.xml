<?xml version="1.0" encoding="utf-8"?>
<!--
    Note: Place Poppins font files in res/font/ directory:
    - poppins_regular.ttf
    - poppins_bold.ttf

    Download from: https://fonts.google.com/specimen/Poppins

    If fonts are not available, Android will fall back to the default system font (Roboto).
    The app will work correctly without these files.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/poppins_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/poppins_bold" />
</font-family>
