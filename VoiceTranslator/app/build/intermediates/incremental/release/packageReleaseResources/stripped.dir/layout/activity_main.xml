<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- AppBar with gradient toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.App.ActionBar"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/toolbar_gradient"
            app:titleTextColor="@android:color/white"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

            <!-- App Title with icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_translate_white"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice Translator"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Language Selector Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- Source Language Spinner -->
                    <Spinner
                        android:id="@+id/spinner_source"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg" />

                    <!-- Swap Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_swap"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="4dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconSize="24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        android:backgroundTint="?attr/colorPrimary" />

                    <!-- Target Language Spinner -->
                    <Spinner
                        android:id="@+id/spinner_target"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Input Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Source Text"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.1" />

                    <!-- Multi-line text input -->
                    <EditText
                        android:id="@+id/et_input_text"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="Enter or speak text to translate…"
                        android:imeOptions="flagNoEnterAction"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="6"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOutline"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_regular" />

                    <!-- Voice hint text -->
                    <TextView
                        android:id="@+id/tv_voice_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙 Listening…"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Input action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <!-- Clear button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Clear"
                            android:textSize="13sp"
                            app:iconSize="18dp" />

                        <!-- Mic button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mic"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_mic"
                            app:iconSize="22dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:strokeColor="?attr/colorPrimary"
                            android:contentDescription="Voice Input" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Translate Button (full width, gradient) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_translate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_translate"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                app:cornerRadius="16dp"
                android:backgroundTint="@null"
                android:background="@drawable/btn_gradient" />

            <!-- Progress bar (loading indicator) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="8dp"
                app:indicatorColor="?attr/colorPrimary" />

            <!-- Output / Translation Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translation"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <!-- Translated text output -->
                    <TextView
                        android:id="@+id/tv_translated_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:text="@string/translation_hint"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="4dp" />

                    <!-- Output action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- Copy button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy"
                            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Copy"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="18dp" />

                        <!-- Speak TTS button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_speak"
                            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:text="Speak"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_volume_up"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Banner Ad at bottom -->
    <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
